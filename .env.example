# Copy to `.env` at the repo root (ADR-008). Never commit real secrets.
# Vite exposes only VITE_* variables to the browser bundle.

# Frontend (public values only)
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
VITE_SOLANA_CLUSTER=devnet
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
VITE_RELIEF_ESCROW_PROGRAM_ID=YOUR_DEVNET_PROGRAM_ID
VITE_DEMO_TOKEN_MINT=YOUR_DEVNET_DEMO_MINT

# Node API — server only
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=SERVER_ONLY_DO_NOT_EXPOSE
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
RELIEF_ESCROW_PROGRAM_ID=YOUR_DEVNET_PROGRAM_ID
DEMO_TOKEN_MINT=YOUR_DEVNET_DEMO_MINT
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_INTERNAL_TOKEN=LOCAL_DEMO_INTERNAL_TOKEN

# Python AI service — server only (ADR-015)
AI_PROVIDER=mock
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=YOUR_MODEL_NAME
AI_API_KEY=SERVER_ONLY_OPTIONAL
AI_INTERNAL_TOKEN=LOCAL_DEMO_INTERNAL_TOKEN
DUPLICATE_MIN_SCORE=0.55

# Demo seed script (ADR-017) — wallet PUBLIC keys only, never private keys
DEMO_USER_PASSWORD=CHOOSE_A_LOCAL_DEMO_PASSWORD
DEMO_REVIEWER_WALLET=REVIEWER_DEVNET_PUBLIC_KEY
DEMO_SUPPLIER_WALLET=SUPPLIER_DEVNET_PUBLIC_KEY
DEMO_DONOR_WALLET=DONOR_DEVNET_PUBLIC_KEY
